<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GuardianCore\GuardianCore.csproj" />
  </ItemGroup>

  <!-- The bots' account rule, compiled in by link. It is pure C# with no NinjaTrader reference (that
       is the whole reason it was extracted), so it can be tested here with no platform, no account
       and no connection - the same terms as every other test in this project. -->
  <ItemGroup>
    <Compile Include="..\..\nt\bots\BotAccountRule.cs" Link="Bots\BotAccountRule.cs" />
    <Compile Include="..\..\nt\addon\GuardedAccountRule.cs" Link="Addon\GuardedAccountRule.cs" />
  </ItemGroup>

</Project>
